{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Hub",
  "version": "0.3.0",
  "identifier": "com.aetherhub.launcher",
  "mainBinaryName": "Aether Hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Aether Hub", "width": 1280, "height": 900, "minWidth": 640, "minHeight": 600, "center": true, "backgroundColor": "#faf8f4", "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost https://cdn.akamai.steamstatic.com https://shared.akamai.steamstatic.com https://cdn.cloudflare.steamstatic.com https://cdn2.steamgriddb.com https://cdn.steamgriddb.com; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/covers/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "shortDescription": "Your games. One home.",
    "longDescription": "A local, artwork-first PC game library and launcher. No Aether account required.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English"], "compression": "lzma" }
    }
  }
}
